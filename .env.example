# Copy to .env (never commit .env). All values optional.
# Local artifact (default) -----------------------------------------------------
MODEL_PATH=models/shieldml_bundle.joblib
# MLflow registry (takes priority when set; falls back to MODEL_PATH on failure) --
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_MODEL_URI=models:/ShieldML-Champion@champion
# API ---------------------------------------------------------------------------
# API_KEY=change-me            # if set, /predict and /metrics require header X-API-Key
SHAP_ENABLED=true
SHAP_API_MODELS=xgboost,lightgbm   # models used for per-request SHAP (RF is slower)
PORT=8000
